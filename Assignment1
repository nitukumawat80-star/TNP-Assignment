#1 Reverse a number and check if prime

num = int(input("Enter a number: "))
rev = 0
n = num
while n > 0:
    digit = n % 10
    rev = rev * 10 + digit
    n = n // 10

print("Reverse =", rev)

if rev > 1:
    i = 2
    prime = True
    while i < rev:
        if rev % i == 0:
            prime = False
            break
        i += 1
    if prime:
        print("Prime")
    else:
        print("Not Prime")
