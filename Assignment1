#6 Accept strings until palindrome entered

while True:
    s = input("Enter a string: ")
    i = 0
    j = len(s) - 1
    pal = True
    while i < j:
        if s[i] != s[j]:
            pal = False
            break
        i += 1
        j -= 1
    if pal:
        print("Palindrome entered! Exiting...")
        break
    else:
        print("Not palindrome, try again.")




