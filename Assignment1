#10 Strong Number (sum of factorials of digits)

num = int(input("Enter a number: "))
n = num
sum_fact = 0

while n > 0:
    digit = n % 10
    fact = 1
    for i in range(1, digit + 1):
        fact *= i
    sum_fact += fact
    n = n // 10

if sum_fact == num:
    print(num, "is a Strong number")
else:
    print(num, "is Not a Strong number")


